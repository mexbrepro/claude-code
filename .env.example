ANTHROPIC_API_KEY=
# Spec §8 calls for "Claude Sonnet 4.5 or higher". Opus 4.7 is the strongest
# 4.x model; switch to claude-sonnet-4-6 if cost is the binding constraint.
ANTHROPIC_MODEL=claude-opus-4-7
DATABASE_URL=postgres://user:pass@localhost:5432/dynamic_companion
APP_URL=http://localhost:3000

# Voice (spec §8). Whisper STT is preferred self-hosted via faster-whisper for
# data residency. WHISPER_ENDPOINT can point at a self-hosted endpoint;
# leaving it unset falls back to OpenAI's hosted Whisper API, which uses
# OPENAI_API_KEY.
WHISPER_ENDPOINT=
OPENAI_API_KEY=

# ElevenLabs for the avatar voice (TTS). Two voice profiles, one per avatar identity.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_LISS=
ELEVENLABS_VOICE_KENA=
ELEVENLABS_VOICE_ANU=
ELEVENLABS_VOICE_WER=
