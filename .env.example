ANTHROPIC_API_KEY=
# Spec §8 calls for "Claude Sonnet 4.5 or higher". Opus 4.7 is the strongest
# 4.x model; switch to claude-sonnet-4-6 if cost is the binding constraint.
ANTHROPIC_MODEL=claude-opus-4-7
DATABASE_URL=postgres://user:pass@localhost:5432/dynamic_companion
APP_URL=http://localhost:3000

# Voice (spec §8). Whisper STT is preferred self-hosted via faster-whisper for
# data residency. WHISPER_ENDPOINT can point at a self-hosted endpoint;
# leaving it unset falls back to OpenAI's hosted Whisper API, which uses
# OPENAI_API_KEY.
WHISPER_ENDPOINT=
OPENAI_API_KEY=

# ElevenLabs for the avatar voice (TTS). Two voice profiles, one per avatar identity.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_LISS=
ELEVENLABS_VOICE_KENA=
ELEVENLABS_VOICE_ANU=
ELEVENLABS_VOICE_WER=

# Magic-link email (spec §8). Set EITHER Resend OR Postmark; whichever
# has credentials in env will be used. Falls back to logging the link
# to stdout when neither is set, so local dev works without an account.
RESEND_API_KEY=
POSTMARK_API_KEY=
POSTMARK_STREAM=outbound
EMAIL_FROM="Dynamic Companion <hello@dynamic-companion.app>"

# FTP/FTPS deployment (see scripts/deploy-ftp.mjs, `npm run deploy:ftp`).
# Uploads the standalone build (.next/standalone + .next/static + public) to a
# Node-capable host. FTP_SECURE defaults to "true" = explicit FTPS over TLS;
# use "implicit" for implicit FTPS, or "false" for plain unencrypted FTP.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_SECURE=true
FTP_REMOTE_DIR=/
# Set to "true" to log the raw FTP protocol exchange when debugging.
FTP_VERBOSE=false
